# ===== Bắt buộc =====
# Telegram bot token từ @BotFather
BOT_TOKEN=8688412463:AAF7ahLInxlDgMP3sqUOA5-ovM6XP67a5qw

# Kaggle API credentials (kaggle.com -> Settings -> API -> Create New API Token,
# mở kaggle.json ra, điền username + key)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Username Kaggle + slug notebook khi push (viết thường, không dấu)
KAGGLE_OWNER=
KAGGLE_KERNEL_SLUG=ai-video-job

# ===== Tuỳ chọn (đã có giá trị mặc định) =====
# Public base URL của VPS trỏ tới job_server (Kaggle sẽ tải ảnh từ đây)
JOB_SERVER_PUBLIC_URL=http://127.0.0.1:8787
# Cổng job_server chạy cục bộ
JOB_SERVER_PORT=8787
# Mật khẩu chung để notebook Kaggle tải file job (tự đặt chuỗi dài ngẫu nhiên)
JOB_TOKEN=change-me-long-random
# Repo GitHub chứa code pipeline (notebook sẽ clone)
REPO_URL=https://github.com/vinhff-ff/ai-video-comparison-tool.git

# Voice mặc định khi user không chọn (vieneu)
DEFAULT_VOICE=Adam

# Run thử không (1) / có (0) — bật khi test
DRY_RUN=0